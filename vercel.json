{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1", "status": 200 },
    { "src": "/assets/(.*)", "dest": "/assets/$1", "status": 200 },
    { "src": "/sw.js", "dest": "/sw.js", "status": 200 },
    { "src": "/manifest.webmanifest", "dest": "/manifest.webmanifest", "status": 200 },
    { "src": "/favicon.svg", "dest": "/favicon.svg", "status": 200 },
    { "src": "/favicon.png", "dest": "/favicon.png", "status": 200 },
    { "src": "/favicon.ico", "dest": "/favicon.ico", "status": 200 },
    { "src": "/pwa-192x192.png", "dest": "/pwa-192x192.png", "status": 200 },
    { "src": "/pwa-512x512.png", "dest": "/pwa-512x512.png", "status": 200 },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml", "status": 200 },
    { "src": "/robots.txt", "dest": "/robots.txt", "status": 200 },
    { "src": "/llms.txt", "dest": "/llms.txt", "status": 200 },
    { "src": "/placeholder.svg", "dest": "/placeholder.svg", "status": 200 },
    { "src": "/branding/(.*)", "dest": "/branding/$1", "status": 200 },
    { "src": "/[^.]+", "dest": "/index.html", "status": 200 }
  ]
}